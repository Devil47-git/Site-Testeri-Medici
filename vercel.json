{
  "functions": { "api/**/*.js": { "maxDuration": 30 } },
  "crons": [
    { "path": "/api/access/attendance?task=close-expired", "schedule": "0 21 * * *" },
    { "path": "/api/access/attendance?task=close-expired", "schedule": "0 22 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
