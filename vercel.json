{
    "functions":  {
                      "api/**/*.js":  {
                                          "maxDuration":  30,
                                          "includeFiles":  "assets/guide/**"
                                      }
                  },
    "crons":  [
                  {
                      "path":  "/api/access/attendance?task=close-expired",
                      "schedule":  "0 21 * * *"
                  },
                  {
                      "path":  "/api/access/attendance?task=close-expired",
                      "schedule":  "0 22 * * *"
                  },
                  {
                      "path":  "/api/access/attendance?task=send-bonus-summary",
                      "schedule":  "0 20 * * 1"
                  },
                  {
                      "path": "/api/access/advent-calendar?cron=draw",
                      "schedule": "0 19 * * *"
                  },
                  {
                      "path": "/api/access/advent-calendar?cron=draw",
                      "schedule": "0 18 * * *"
                  }
              ],
    "headers":  [
                    {
                        "source":  "/(.*)\\.(js|css|html)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-cache"
                                        }
                                    ]
                    },
                    {
                        "source":  "/",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-cache"
                                        }
                                    ]
                    }
                ]
}
